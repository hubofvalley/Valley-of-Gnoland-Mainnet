  },
  "endpoints": {
    "web": "https://gno.land",
    "rpc": "https://rpc.gno.land",
    "comparison_rpc": "https://rpc.gno.land",
    "faucet": null,
    "official_persistent_peers": "g15rcv5yqef3kvnmueqvkyw8y05sd40jz9p3n5su@seed-1.gno.land:26656,g1ck2yeyvvnpl92237gcea0z68jx07a4nnyvuaan@seed-2.gno.land:26656",
