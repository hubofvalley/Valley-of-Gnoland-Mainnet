{
  "schema": 1,
  "project": "Valley of Gnoland",
  "network": "Gno.land mainnet",
  "chain_id": "gnoland-1",
  "architecture": "v1",
  "visibility": "public",
  "public_launcher": "direct",
  "default_branch": "main",
  "entrypoint": "resources/valleyofGnoland.sh",
  "services": [
    "gnoland.service"
  ],
  "components": [
    {
      "id": "gnoland",
      "kind": "single Cosmos/CometBFT-style Gno service",
      "service": "gnoland.service",
      "capabilities": [
        "verified_release_install",
        "verified_release_update",
        "transactional_runtime_cutover",
        "update_rollback",
        "validator_identity_preservation",
        "release_drift_detection",
        "node_status",
        "peer_config",
        "key_management",
        "candidate_registration",
        "read_only_diagnostics",
        "account_dashboard",
        "validator_identity_status",
        "valoper_profile_management",
        "validator_key_rotation",
        "realm_query_inspector"
      ],
      "ports": [
        {
          "role": "p2p",
          "default": "26656",
          "exposure": "public"
        },
        {
          "role": "rpc",
          "default": "26657",
          "exposure": "loopback"
        },
        {
          "role": "abci",
          "default": "26658",
          "exposure": "loopback"
        }
      ],
      "paths": {
        "source": "$HOME/gno",
        "deployment": "$HOME/gno/misc/deployments/mainnet.gno.land",
        "node_home": "$HOME/gno/gnoland-data",
        "keyring": "$HOME/.config/gno",
        "binaries": "$HOME/go/bin"
      }
    }
  ],
  "release": {
    "tag": "chain/mainnet",
    "commit": "9c8eb132e483d6fd324d92c193e629ad65a98a37",
    "tag_commit": "9c8eb132e483d6fd324d92c193e629ad65a98a37",
    "versioned_tag": "v1.2.0",
    "versioned_commit": "9c8eb132e483d6fd324d92c193e629ad65a98a37",
    "genesis_commit": "9c8eb132e483d6fd324d92c193e629ad65a98a37",
    "source_branch": "chain/mainnet",
    "source_commit": "00417a1be97b9a311d9669ae7aa9585b277ee594",
    "deployment_path": "misc/deployments/mainnet.gno.land/",
    "genesis_sha256": "ea22691003130eae3ba975b7d16460706b5d75ce6c04ae82c0c4faeab7de91f0",
    "source_repository": "https://github.com/gnolang/gno.git"
  },
  "install": {
    "mode": "verified_release_assets",
    "cutover": "stage_first_transactional",
    "persistent_backup": "optional_prompt",
    "preserve_existing_node_secrets": true,
    "prebuilt_assets": true,
    "platform": "linux_amd64",
    "asset_base_url": "https://github.com/gnolang/gno/releases/download/chain/mainnet",
    "assets": {
      "gnoland": "gnoland_linux_amd64",
      "gnokey": "gnokey_linux_amd64"
    },
    "reported_version": "chain/mainnet.3435+139a63fe6",
    "binary_sha256": {
      "gnoland": "ef393f4e15f433cf966468fa6a8f65f1a1a69dc854f6fe843a3931a6ec0711d3",
      "gnokey": "86be6aa70bd2c030b50823477e774c75a1f5d63d9387630eb5f39ffa1b62ae14"
    }
  },
  "genesis": {
    "path": "misc/deployments/mainnet.gno.land/genesis.json",
    "url": "https://github.com/gnolang/gno/releases/download/chain/mainnet/genesis.json",
    "sha256": "ea22691003130eae3ba975b7d16460706b5d75ce6c04ae82c0c4faeab7de91f0",
    "compressed_url": "https://github.com/gnolang/gno/releases/download/chain/mainnet/genesis.json.gz",
    "compressed_sha256": "32a0fef8db3c71fa8360dee39a0149ee961be115ba81363a15f854e4aad446c9"
  },
  "snapshot": {
    "status": "disabled",
    "provider": null,
    "requires": "a provider independently verified for gnoland-1"
  },
  "endpoints": {
    "web": "https://gno.land",
    "rpc": "https://rpc.gno.land",
    "comparison_rpc": "https://rpc.gno.land",
    "faucet": null,
    "official_persistent_peers": "g15rcv5yqef3kvnmueqvkyw8y05sd40jz9p3n5su@seed-1.gno.land:26656,g1ck2yeyvvnpl92237gcea0z68jx07a4nnyvuaan@seed-2.gno.land:26656",
    "active_validator_realm": "r/sys/validators/v0"
  },
  "candidate_registration": {
    "status": "enabled",
    "candidate_realm": "r/gnops/valopers",
    "function": "Register",
    "gas_fee": "1000000ugnot",
    "gas_wanted": 50000000,
    "chain_id": "gnoland-1",
    "remote": "https://rpc.gno.land",
    "active_realm": "r/sys/validators/v0",
    "requires_govdao_approval": true,
    "public_faucet": false,
    "runtime_register_fee_guard": "GetValoperRegisterFee()==0"
  },
  "exposure_rules": {
    "p2p": "public when required for peer connectivity",
    "rpc": "loopback by default",
    "abci": "loopback by default"
  },
  "validator_interactions": {
    "account_queries": [
      "bank/balances/{address}",
      "auth/accounts/{address}",
      "auth/gasprice"
    ],
    "candidate_realm": "r/gnops/valopers",
    "active_realm": "r/sys/validators/v0",
    "profile_updates": [
      "UpdateMoniker",
      "UpdateDescription",
      "UpdateServerType",
      "UpdateKeepRunning"
    ],
    "signing_key_rotation": "UpdateSigningKey",
    "read_only_vm_queries": [
      "vm/qrender",
      "vm/qfuncs",
      "vm/qdoc",
      "vm/qeval",
      "vm/qstorage",
      "vm/qpaths"
    ]
  }
